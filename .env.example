# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAI (sponsor key on the day). Base URL + model kept swappable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google (read-only Calendar + Gmail) — one shared account is enough for the demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Cloud Messaging (nudge delivery)
FCM_SERVER_KEY=

# OpenRouter — voice model (OpenAI-compatible gateway). https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Exa (sponsor) — companion web-search grounding. https://exa.ai/docs
EXA_API_KEY=
