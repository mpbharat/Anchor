# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAI (sponsor key on the day). Base URL + model kept swappable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google (read-only Calendar + Gmail) — one shared account is enough for the demo
# OAuth client type "Web application". The redirect URI below must be listed on
# that client character for character, or Google returns redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to the local backend when unset. The Android emulator reaches it on
# localhost via `adb reverse tcp:3000 tcp:3000`. In production point this at the
# deployed backend, e.g. https://anchor-qo9j.onrender.com/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Firebase Cloud Messaging (nudge delivery)
FCM_SERVER_KEY=

# OpenRouter — voice model (OpenAI-compatible gateway). https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Exa (sponsor) — companion web-search grounding. https://exa.ai/docs
EXA_API_KEY=
