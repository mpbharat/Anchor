# backend/ service env. Copy to backend/.env (gitignored). The service also reads
# the repo-root .env as a fallback, so shared keys can live there instead.

PORT=3000
NODE_ENV=development

# Supabase (Project Settings -> API). New-format keys (sb_secret_* / sb_publishable_*)
# or the legacy SERVICE_ROLE / ANON names — either is accepted.
SUPABASE_URL=https://kdpgslmbvyybulgashxz.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternatives:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
